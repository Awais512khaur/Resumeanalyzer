# Copy this file to .env on the server and replace every placeholder.
APP_DOMAIN=resume.example.com
DB_NAME=resume_analyzer
DB_USER=resume_app
DB_PASSWORD=replace-with-a-long-random-database-password
DB_ROOT_PASSWORD=replace-with-a-different-long-random-password

# Generate a new key; do not reuse a key that was committed to this repository.
GEMINI_API_KEY=

# Optional password-reset email. Use an SMTP app password or provider credential.
RESUME_SMTP_HOST=
RESUME_SMTP_PORT=587
RESUME_SMTP_USERNAME=
RESUME_SMTP_PASSWORD=
RESUME_SMTP_ENCRYPTION=tls
RESUME_MAIL_FROM_EMAIL=
RESUME_MAIL_FROM_NAME=ResumeAI
